.reports-workspace { max-width: 1600px; margin-inline: auto; }
.reports-workspace .rp-header { gap: 20px; margin-bottom: 16px; }
.reports-workspace .rp-contexts { gap: 6px; max-width: 680px; }
.reports-workspace .rp-context { white-space: normal; font-size: 11px; line-height: 1.5; color: var(--text-2); background: var(--surface); border: 1px solid var(--line); }
.reports-workspace .rp-context.forecast { color: var(--muted); }
.rp-section-nav { display: flex; flex-wrap: wrap; gap: 6px; padding-bottom: 18px; margin-bottom: 20px; border-bottom: 1px solid var(--line); }
.rp-section-nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 9px 14px; border-radius: 9px; border: 1px solid var(--line); color: var(--text-2); background: var(--surface); font-size: 12px; font-weight: 700; text-decoration: none; }
.rp-section-nav a:hover, .rp-section-nav a:focus-visible { color: var(--primary-dark); border-color: var(--primary); background: var(--primary-light); }
.reports-workspace [id^="report"] { scroll-margin-top: calc(var(--topbar-h) + 18px); }
.reports-workspace .card { min-width: 0; border-width: 1px; box-shadow: none; }
.reports-workspace .rp-filters .card-body { padding: 20px; }
.reports-workspace .rp-filter-group { background: var(--surface-2); border: 1px solid var(--line); padding: 18px; }
.reports-workspace .rp-filter-group.forecast { background: var(--surface-2); border-color: var(--line); }
.reports-workspace .rp-filter-group-title strong { font-size: 15px; }
.reports-workspace .rp-filter-group-title span { line-height: 1.5; }
.reports-workspace .rp-filter-fields { grid-template-columns: minmax(150px,.8fr) repeat(2,minmax(0,1fr)); }
.reports-workspace .input { min-height: 46px; }
.reports-workspace .btn, .reports-workspace .forecast-modal-trigger { min-height: 44px; }
.reports-workspace .rp-actions-row { border-top-width: 1px; }
.rp-submit-actions { display: flex; gap: 8px; flex-wrap: wrap; }
.rp-date-presets { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
.rp-date-presets button { min-height: 44px; padding: 8px 14px; background: var(--surface); color: var(--text-2); border: 1px solid var(--line-2); border-radius: 9px; font: inherit; font-size: 12px; font-weight: 600; cursor: pointer; }
.rp-date-presets button[aria-pressed="true"] { color: var(--primary-dark); border-color: var(--primary); background: var(--primary-light); }
.rp-export-note { color: var(--muted); font-size: 12px; margin-top: 12px; }
.rp-pending-filters { padding: 12px; margin-top: 10px; border-radius: 9px; font-size: 12px; line-height: 1.5; background: var(--warning-bg); color: var(--warning-text); }
.rp-section-heading { margin: 28px 0 14px; }
.rp-section-heading h2 { color: var(--text); font-family: var(--heading-font); font-size: 19px; margin: 0 0 4px; }
.rp-section-heading p { color: var(--muted); font-size: 12px; margin: 0; }
.reports-workspace .kpi-grid { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; }
.reports-workspace .kpi { min-width: 0; padding: 18px; border-width: 1px; box-shadow: none; border-radius: 14px; }
.reports-workspace .kpi::before { display: none; }
.reports-workspace .kpi-top { flex-direction: row-reverse; margin-bottom: 12px; gap: 10px; }
.reports-workspace .kpi-label { text-align: left; font-size: 12px; letter-spacing: 0; text-transform: none; }
.reports-workspace .kpi-value, .reports-workspace .kpi-value.sm { font-family: var(--heading-font); font-size: clamp(20px,2vw,28px); line-height: 1.25; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.reports-workspace .kpi-sub { font-size: 11px; line-height: 1.5; }
.reports-workspace .kpi:nth-child(2) { background: var(--primary-light); border-color: var(--primary); }
.reports-workspace .kpi:nth-child(4) { border-color: var(--success-text); }
.reports-workspace .card-head { padding: 18px 20px; flex-wrap: wrap; gap: 12px; }
.reports-workspace .card-head h2 { font-size: 16px; }
.reports-workspace .card-head p { line-height: 1.6; max-width: 90ch; }
.reports-workspace .card-head-tag { white-space: normal; line-height: 1.5; }
.reports-workspace .tag-purple { background: var(--primary-light); color: var(--primary-dark); }
.reports-workspace .dash-two-col { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; }
.reports-workspace .chart-wrap { min-width: 0; }
.reports-workspace .chart-wrap canvas[hidden] { display: none !important; }
/* Restock workspace: fixed controls around one scrollable reading area. */
#forecastModalOverlay [hidden]{display:none!important}
#forecastModalOverlay .forecast-modal{max-width:1160px;height:min(840px,calc(100dvh - 48px))}
#forecastModalOverlay .forecast-modal-head{padding:18px 24px;align-items:flex-start}
#forecastModalOverlay .restock-eyebrow{display:block;color:var(--primary-dark);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.12em;margin-bottom:5px}
html.dark #forecastModalOverlay .restock-eyebrow{color:var(--sb-active-text)}
#forecastModalOverlay h2{margin:0;font-size:19px}
#forecastModalOverlay #restockContext{margin:6px 0 0;font-size:12px;color:var(--muted);line-height:1.5}
#forecastModalOverlay .restock-controls{flex:none;padding:0 24px 12px;border-bottom:1px solid var(--line);background:var(--surface)}
#forecastModalOverlay .restock-tabs{display:flex;border-bottom:1px solid var(--line);gap:24px;margin-bottom:14px}
#forecastModalOverlay .restock-tabs button{display:flex;align-items:center;gap:8px;min-height:48px;padding:10px 0;border:0;border-bottom:3px solid transparent;background:transparent;color:var(--muted);font:inherit;font-size:13px;font-weight:700;cursor:pointer}
#forecastModalOverlay .restock-tabs button[aria-selected=true]{color:var(--text);border-bottom-color:var(--primary)}
#forecastModalOverlay .restock-tabs span{padding:2px 7px;border-radius:6px;background:var(--surface-2);color:var(--muted);font-size:11px;font-variant-numeric:tabular-nums}
#forecastModalOverlay .restock-tabs button[aria-selected=true] span{background:var(--primary-light);color:var(--text)}
#forecastModalOverlay .restock-tools{display:flex;align-items:flex-end;gap:12px}
#forecastModalOverlay .restock-tools label{min-width:0;margin:0}
#forecastModalOverlay .restock-tools label>span{display:block;color:var(--text-2);font-size:11px;font-weight:600;margin-bottom:6px}
#forecastModalOverlay .restock-search{flex:1}
#forecastModalOverlay .restock-priority{width:180px}
#forecastModalOverlay .restock-tools input,#forecastModalOverlay .restock-tools select{width:100%;min-width:0;min-height:44px;border:1px solid var(--line-2);background:var(--surface-2);color:var(--text);padding:10px 12px;border-radius:9px;font:inherit;font-size:14px}
#forecastModalOverlay .restock-result-count{font-size:11px;color:var(--muted);margin:10px 0 0}
#forecastModalOverlay .forecast-modal-body{flex:1;min-height:0;padding:20px 24px;background:var(--surface-2);scrollbar-gutter:stable;scrollbar-color:var(--muted) var(--surface-2)}
#forecastModalOverlay .restock-panel{background:transparent;border-radius:0;margin:0}
#forecastModalOverlay .restock-panel .card-head{padding:0 0 16px;gap:12px}
#forecastModalOverlay .restock-panel h2{font-size:15px}
#forecastModalOverlay .restock-panel .card-head p{font-size:12px;margin-top:5px}
#forecastModalOverlay .restock-panel table{background:var(--surface);border:1px solid var(--line)}
#forecastModalOverlay .restock-panel th{background:var(--surface-2);font-size:10px;padding-block:11px}
#forecastModalOverlay .restock-panel td{font-size:12px;padding-block:16px;vertical-align:top}
#forecastModalOverlay .restock-order strong{display:inline-block;font-size:20px;line-height:1.2;font-variant-numeric:tabular-nums;color:var(--text)}
#forecastModalOverlay .restock-order>span{font-size:11px;color:var(--muted)}
#forecastModalOverlay [data-priority=critical] td:first-child{box-shadow:inset 3px 0 var(--danger-text);padding-left:14px}
#forecastModalOverlay [data-priority=warning] td:first-child{box-shadow:inset 3px 0 var(--warning-text);padding-left:14px}
#forecastModalOverlay .forecast-log-table th:first-child{width:5%}
#forecastModalOverlay .forecast-log-table th:nth-child(2){width:22%}
#forecastModalOverlay .forecast-log-table th:nth-child(4){width:25%}
#forecastModalOverlay .restock-guidance{font-size:11px;line-height:1.65;color:var(--muted);margin:16px 0 0;padding:12px 14px;border:1px solid var(--line);border-radius:9px;background:var(--surface)}
#forecastModalOverlay .restock-empty{text-align:center;padding:32px 16px;color:var(--text)}
#forecastModalOverlay .restock-empty p{color:var(--muted);font-size:13px;line-height:1.5;margin:8px 0 18px}
#forecastModalOverlay .restock-footer{display:flex;align-items:center;gap:10px;flex:none;border-top:1px solid var(--line);padding:14px 24px;background:var(--surface)}
#forecastModalOverlay .restock-footer p{flex:1;font-size:11px;color:var(--muted);margin:0;max-width:48ch;line-height:1.5;margin-right:auto}
#forecastModalOverlay .btn{min-height:44px;white-space:normal;line-height:1.4}
#forecastModalOverlay .btn:not(.btn-primary){background:var(--surface-2);color:var(--text);border:1px solid var(--line-2)}
#forecastModalOverlay .btn:not(.btn-primary):hover{background:var(--surface);border-color:var(--primary)}
#forecastModalOverlay .restock-panel thead th{position:sticky;top:-20px;z-index:1}
#forecastModalOverlay :is(button,input,select,[role=tabpanel]):focus-visible{outline:2px solid var(--primary);outline-offset:3px}
@media(max-width:900px){
 #forecastModalOverlay .restock-panel table{border:0;background:transparent}
 #forecastModalOverlay .restock-panel tr{background:var(--surface)}
 #forecastModalOverlay .restock-panel td{padding-block:0}
 #forecastModalOverlay .restock-panel td:first-child{padding-bottom:12px}
 #forecastModalOverlay [data-priority=critical],#forecastModalOverlay [data-priority=warning]{border-left:3px solid var(--warning-text)}
 #forecastModalOverlay [data-priority=critical]{border-left-color:var(--danger-text)}
 #forecastModalOverlay [data-priority] td:first-child{box-shadow:none;padding-left:0}
 #forecastModalOverlay .forecast-log-table td:nth-child(4){grid-column:1/-1}
}
@media(max-width:600px){
 #forecastModalOverlay .forecast-modal{height:calc(100dvh - 20px)}
 #forecastModalOverlay .forecast-modal-head{padding:14px 16px}
 #forecastModalOverlay .restock-controls{padding:0 16px 10px}
 #forecastModalOverlay .restock-tabs{gap:16px;margin-bottom:12px}
 #forecastModalOverlay .restock-tabs button{font-size:12px;gap:5px}
 #forecastModalOverlay .restock-tools{flex-wrap:wrap;gap:8px}
 #forecastModalOverlay .restock-search{flex:1 0 100%}
 #forecastModalOverlay .restock-priority{width:auto;flex:1}
 #forecastModalOverlay .restock-tools input,#forecastModalOverlay .restock-tools select{font-size:16px}
 #forecastModalOverlay .forecast-modal-body{padding:14px 12px}
 #forecastModalOverlay .restock-footer{padding:10px 12px max(10px,env(safe-area-inset-bottom))}
 #forecastModalOverlay .restock-footer p{display:none}
 #forecastModalOverlay .restock-footer .btn{flex:1;font-size:12px;padding-inline:10px}
 #forecastModalOverlay .restock-panel .card-head{flex-wrap:wrap}
}
@media(max-height:520px){
 #forecastModalOverlay .forecast-modal-head{padding:8px 16px}
 #forecastModalOverlay .restock-eyebrow,#forecastModalOverlay #restockContext,#forecastModalOverlay .restock-tools label>span,#forecastModalOverlay .restock-footer p{display:none}
 #forecastModalOverlay .restock-controls{padding-bottom:6px}
 #forecastModalOverlay .restock-tabs{margin-bottom:6px}
 #forecastModalOverlay .restock-tools{flex-wrap:nowrap}
 #forecastModalOverlay .restock-search{flex:1;min-width:0}
 #forecastModalOverlay .restock-result-count{margin-top:5px}
 #forecastModalOverlay .restock-footer{padding-block:6px}
}
.rp-chart-empty { position: absolute; inset: 0; box-sizing: border-box; margin: 0; min-height: 0; display: grid; place-items: center; padding: 30px; text-align: center; color: var(--muted); font-size: 13px; background: var(--surface-2); border: 1px dashed var(--line); border-radius: 12px; }
.reports-workspace .table-wrap { max-width: 100%; }
.reports-workspace table { width: 100%; }
.reports-workspace th { font-size: 10px; }
.reports-workspace td { font-size: 12px; line-height: 1.5; }
.rp-cash-summary { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10px; padding: 0 20px 18px; }
.rp-cash-summary div { min-width: 0; padding: 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface-2); }
.rp-cash-summary span { display: block; font-size: 11px; color: var(--muted); margin-bottom: 5px; }
.rp-cash-summary strong { font-size: 17px; color: var(--text); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.reports-workspace .table-wrap.rp-cash-scroll { max-height: min(480px, 60vh); overflow: auto; scrollbar-gutter: stable; scrollbar-color: var(--muted) var(--surface-2); }
.reports-workspace .rp-cash-scroll::-webkit-scrollbar { width: 12px; height: 12px; }
.reports-workspace .rp-cash-scroll::-webkit-scrollbar-track { background: var(--surface-2); }
.reports-workspace .rp-cash-scroll::-webkit-scrollbar-thumb { background: var(--muted); border: 3px solid var(--surface-2); border-radius: 8px; }
.reports-workspace .rp-cash-scroll:focus-visible { outline: 2px solid var(--primary); outline-offset: -2px; }
.reports-workspace .rp-cash-scroll thead th { position: sticky; top: 0; z-index: 2; background: var(--surface-2); }
@media print {
    .reports-workspace .rp-cash-scroll { max-height: none !important; overflow: visible !important; scrollbar-gutter: auto; }
    .reports-workspace .rp-cash-scroll thead th { position: static; }
}
html.dark .rp-section-nav a:hover, html.dark .rp-date-presets button[aria-pressed="true"], html.dark .reports-workspace .tag-purple { color: var(--sb-active-text); }
@media (max-width: 1000px) {
    .reports-workspace .dash-two-col { grid-template-columns: minmax(0,1fr); }
    .rp-cash-summary { grid-template-columns: repeat(2,minmax(0,1fr)); }
}
@media (max-width: 700px) {
    .reports-workspace .rp-contexts { justify-content: flex-start; }
    .reports-workspace .rp-filters .card-body { padding: 14px; }
    .reports-workspace .rp-filter-group { padding: 14px; }
    .reports-workspace .rp-filter-group-title { align-items: flex-start; }
    .reports-workspace .rp-filter-group-title > .card-head-tag { display: none; }
    .reports-workspace .rp-filter-fields { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .reports-workspace .rp-filter-fields .field:first-child { grid-column: 1/-1; }
    .reports-workspace .rp-shared-filter .field { min-width: 0; width: 100%; }
    .reports-workspace .rp-shared-filter > button { width: 100%; }
    .reports-workspace .input { font-size: 16px; width: 100%; min-width: 0; }
    .reports-workspace .rp-actions-row > .row { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); width: 100%; }
    .reports-workspace .rp-actions-row > .row a:first-child { grid-column: 1/-1; }
    .reports-workspace .rp-actions-row .btn { white-space: normal; }
    .rp-submit-actions { width: 100%; }
    .rp-submit-actions button { flex: 1; }
    .reports-workspace .kpi-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }
    .reports-workspace .kpi { padding: 14px; }
    .reports-workspace .kpi-top { align-items: flex-start; flex-direction: row; }
    .reports-workspace .kpi-icon { display: none; }
    .reports-workspace .kpi:last-child { grid-column: 1/-1; }
    .reports-workspace .table-scroll { max-height: none; }
    .reports-workspace .mobile-record-ready td { overflow-wrap: anywhere; white-space: normal; }
    .reports-workspace .mobile-record-ready .record-title { color: var(--text); }
    .rp-section-nav { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 6px; }
    .rp-section-nav a { padding: 8px; text-align: center; justify-content: center; font-size: 11px; }
    .rp-date-presets { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); }
    .rp-date-presets button { padding-inline: 5px; }
    .reports-workspace .chart-wrap { height: 270px; }
}
@media (max-width: 380px) {
    .reports-workspace .rp-filter-fields { grid-template-columns: minmax(0,1fr); }
    .reports-workspace .kpi-value, .reports-workspace .kpi-value.sm { font-size: 19px; }
    .rp-cash-summary { padding-inline: 14px; }
}
