                right: 12px;
                left: 12px;
                width: auto;
            }

            /* Cards & tables: tighten padding/type-scale for small screens */
            .card-head, .card-body { padding: 14px 16px; }
            .page-header h1 { font-size: 20px; }
            table th, table td { padding: 10px 12px; font-size: 13px; }

            /* Prevent iOS Safari from auto-zooming when a field is focused */
            input[type="text"], input[type="number"], input[type="password"],
            input[type="email"], input[type="date"], select, textarea, .input {
                font-size: 16px;
            }
        }


        /* Global connection notice. This does not provide offline mode; it
           prevents users from assuming that server actions were received. */
        .global-connection-banner {
            position: fixed;
            top: 10px;
            left: 50%;
            z-index: 1200;
            transform: translate(-50%, -18px);
            display: flex;
            align-items: center;
            gap: 9px;
            max-width: min(620px, calc(100vw - 24px));
            padding: 10px 14px;
            border: 1px solid #ef9a9a;
            border-radius: 10px;
            background: #fff1f1;
            color: #8f1d1d;
            box-shadow: 0 8px 30px rgba(80, 15, 15, .18);
            font-size: 13px;
            font-weight: 700;
            line-height: 1.35;
            opacity: 0;
            pointer-events: none;
            transition: opacity .18s ease, transform .18s ease;
        }
        .global-connection-banner.show {
            opacity: 1;
            transform: translate(-50%, 0);
        }
        .global-connection-banner.restored {
            border-color: #86d5a5;
            background: #edfff4;
            color: #126332;
        }
        .global-connection-dot {
            width: 9px;
            height: 9px;
            flex: 0 0 auto;
            border-radius: 50%;
            background: currentColor;
            box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 16%, transparent);
        }
        html.dark .global-connection-banner {
            border-color: rgba(239,154,154,.5);
            background: #311b22;
            color: #ffc0c0;
        }
        html.dark .global-connection-banner.restored {
            border-color: rgba(134,213,165,.45);
            background: #153326;
            color: #adf1c6;
        }
        @media (max-width: 620px) {
            .global-connection-banner {
                top: 8px;
                width: calc(100vw - 16px);
                max-width: none;
                justify-content: center;
                text-align: center;
            }
        }


        /* Automatic list/report filters. JavaScript adds these classes only
           after it has attached the auto-submit behavior, so the normal
           Filter/Search buttons remain a reliable no-JavaScript fallback. */
        form.auto-filter-enabled {
            position: relative;
        }
        .auto-filter-status {
            display: none;
            align-items: center;
            gap: 7px;
            flex: 1 0 100%;
            width: 100%;
            margin-top: 4px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
            line-height: 1.35;
        }
        .auto-filter-status.show {
            display: inline-flex;
        }
        .auto-filter-status::before {
            content: '';
            width: 11px;
            height: 11px;
            flex: 0 0 auto;
            border: 2px solid var(--line-2);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: auto-filter-spin .7s linear infinite;
        }
        .auto-filter-status.invalid {
            color: var(--danger-text);
        }
        .auto-filter-status.invalid::before,
        .auto-filter-status.offline::before {
            animation: none;
            border: 0;
            width: auto;
            height: auto;
            content: '⚠';
        }
        .auto-filter-status.offline {
            color: var(--warning-text);
        }
        form.auto-filter-submitting :is(input, select, textarea, button[type="submit"]) {
            cursor: wait;
        }
        form.auto-filter-submitting button[type="submit"] {
            opacity: .72;
        }
        form.auto-filter-enabled :is(input, select, textarea).auto-filter-invalid {
            border-color: var(--danger) !important;
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--danger) 13%, transparent) !important;
        }
        @keyframes auto-filter-spin { to { transform: rotate(360deg); } }
        html.reduce-motion .auto-filter-status::before { animation: none; }

