<script>
document.addEventListener('DOMContentLoaded', function () {
    const discountedSale = true;
    const originalTotal = 50;
    const originalFinalTotal = 40;
    const originalDiscount = 10;
    const money = window.PharxmacoDiscount;
    const amountPaid = 100;
    const paymentMethod = document.getElementById('paymentMethod');
    const referenceNo = document.getElementById('referenceNo');
    const referenceHint = document.getElementById('referenceHint');
    const submitButton = document.querySelector('.save-btn');

    function fmt(v) {
        return '₱' + parseFloat(v).toFixed(2);
    }

    function recalc() {
        let total = 0;
        let quantitiesChanged = false;
        let totalQuantity = 0;
        document.querySelectorAll('#itemsBody tr').forEach(function(row) {
            const price    = parseFloat(row.getAttribute('data-price') || 0);
            const input    = row.querySelector('.qty-input');
            const original = parseInt(input.getAttribute('data-original') || 0);
            const qty      = Math.max(0, parseInt(input.value) || 0);
            const sub      = money.cents(price) * qty / 100;
            totalQuantity += qty;
            total += sub;
            row.querySelector('.subtotal-cell').textContent = fmt(sub);
            if (qty !== original) {
                quantitiesChanged = true;
                input.classList.add('qty-changed');
            } else {
                input.classList.remove('qty-changed');
            }
        });

        const newTotal = document.getElementById('newTotalCell');
        const discountCell = document.getElementById('discountTotalCell');
        const finalCell = document.getElementById('finalTotalCell');
        const discountTotal = originalDiscount;
        if (discountedSale) total = originalTotal;
        const finalTotal = discountedSale ? originalFinalTotal : Math.max(0, money.cents(total) - money.cents(discountTotal)) / 100;
        if (newTotal) newTotal.textContent = fmt(total);
        if (discountCell) discountCell.textContent = '− ' + fmt(discountTotal);
        if (finalCell) {
            finalCell.textContent = fmt(finalTotal);
            finalCell.style.color = finalTotal > amountPaid + 0.009 ? 'var(--danger)' : 'var(--primary-dark)';
        }
        const notice = document.getElementById('correctionPreviewNotice');
        const exceedsPayment = finalTotal > amountPaid + 0.009;
        const emptySale = totalQuantity <= 0;
        const quantityLocked = discountedSale && quantitiesChanged;
        if (notice) {
            if (quantityLocked) {
                notice.textContent = 'Use a refund and a new sale to change quantities on a discounted sale. Notes and payment details can still be corrected.';
                notice.style.display = 'block';
            } else if (emptySale) {
                notice.textContent = 'Keep at least one item in a completed sale. Use Refund to reverse the entire sale.';
                notice.style.display = 'block';
            } else if (exceedsPayment) {
                notice.textContent = 'The corrected total is higher than the amount paid. Record extra items as a new sale.';
                notice.style.display = 'block';
            } else {
                notice.textContent = '';
                notice.style.display = 'none';
            }
        }
        if (submitButton) submitButton.disabled = exceedsPayment || emptySale || quantityLocked;
    }

    function updateReferenceRequirement() {
        referenceNo.required = false;
        referenceHint.textContent = '(optional)';
        referenceNo.placeholder = paymentMethod.value === 'gcash'
            ? 'Optional GCash reference number'
            : paymentMethod.value === 'card'
                ? 'Optional card approval/reference number'
                : 'Not needed for cash';
        if (paymentMethod.value === 'cash') referenceNo.value = '';
    }

    document.querySelectorAll('.qty-input').forEach(function(inp) {
        inp.addEventListener('input', recalc);
    });
    paymentMethod.addEventListener('change', updateReferenceRequirement);
    updateReferenceRequirement();
    recalc();
});
</script>

