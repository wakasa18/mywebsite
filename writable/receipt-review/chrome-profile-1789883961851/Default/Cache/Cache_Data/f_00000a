        /* Global connection notice. This does not provide offline mode; it
           prevents users from assuming that server actions were received. */
        .global-connection-banner {
            position: fixed;
            top: 10px;
            left: 50%;
            z-index: 1200;
            transform: translate(-50%, -18px);
            display: flex;
            align-items: center;
            gap: 9px;
            max-width: min(620px, calc(100vw - 24px));
