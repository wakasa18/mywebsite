# ==============================
# CodeIgniter 4
# ==============================

# Environment configuration / secrets
.env
.env.*
!.env.example

# Composer dependencies
/vendor/

# Writable runtime files
/writable/cache/*
!/writable/cache/index.html

/writable/debugbar/*
!/writable/debugbar/index.html

/writable/logs/*
!/writable/logs/index.html

/writable/session/*
!/writable/session/index.html

/writable/uploads/*
!/writable/uploads/index.html

# PHPUnit
.phpunit.result.cache
.phpunit.cache/

# IDE / Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.log
*.bak
*.swp

# Node dependencies, if used
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build/cache files
.cache/

# Local database files
*.sqlite
*.sqlite3